{
  "name": "rlrp-main-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Rotterdam Roleplay management, moderation and security bot",
  "type": "module",
  "main": "index.js",
  "engines": { "node": ">=24.12.0 <25" },
  "scripts": {
    "start": "node index.js",
    "register": "node register.js",
    "check": "node scripts/check.js",
    "test": "node --test tests/*.test.js",
    "doctor": "node --env-file-if-exists=.env scripts/doctor.js",
    "invite": "node --env-file-if-exists=.env scripts/invite.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.js",
    "config:export": "node --env-file-if-exists=.env scripts/config.js export",
    "config:import": "node --env-file-if-exists=.env scripts/config.js import"
  },
  "dependencies": { "discord.js": "14.27.0" }
}
