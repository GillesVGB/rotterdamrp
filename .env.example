# Alleen echte waarden invullen; deel dit bestand nooit met ingevulde secrets.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
# Optionele beschermde gebruikers (geeft op zichzelf geen commandrechten).
BOT_OWNER_IDS=
# Extra Beheerrollen, komma-gescheiden. Voor RLRP is 1226509285924540473 ingebouwd.
MANAGEMENT_ROLE_IDS=
# Compatibiliteit met oudere hostingconfiguratie; eveneens Beheerrollen.
BOT_OWNER_ROLE_IDS=
REGISTER_COMMANDS_ON_START=true
DATABASE_PATH=./data/rlrp.sqlite
CONFIG_PATH=./config/default.json
# Vast vertrouwd FiveM-endpoint; alleen via dit bestand instellen (geen URL uit commands).
FIVEM_BASE_URL=
FIVEM_JOIN_URL=
